# ── ThingSpeak — server-side only ──────────────────────────────────────
#
# Set these in the Vercel project (Settings -> Environment Variables), or
# copy this file to .env.local for `vercel dev`. With TS_CHANNEL_ID set,
# the dashboard switches itself into proxy mode and the keys never reach
# the browser.
#
# Leave them all unset and the dashboard still works — it falls back to
# reading keys from localStorage in the browser instead.

# Required for proxy mode. Not a secret; it is in the public channel URL.
TS_CHANNEL_ID=YOUR_CHANNEL_ID

# Optional for a public channel, required for a private one.
TS_READ_API_KEY=YOURREADKEY

# Required to send AUTO / ON / OFF. Without it the dashboard is read-only.
TS_WRITE_API_KEY=YOURWRITEKEY

# ── Optional: gate the relay ───────────────────────────────────────────
#
# READ THIS IF YOU DEPLOY PUBLICLY. In proxy mode the browser needs no key
# to write, so anyone who loads your deployment URL can switch the relay.
# Set DASHBOARD_TOKEN to any long random string to require a shared secret
# on /api/update, then supply it once per browser:
#
#     localStorage.setItem('ts_dashboard_token', 'the-same-string');
#     location.reload();
#
# Leave it blank and relay control is open to anyone with the URL.
DASHBOARD_TOKEN=
